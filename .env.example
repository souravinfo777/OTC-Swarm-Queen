# Environment Configuration
ENV=development
DATA_SOURCE=DEMO
EXECUTION_MODE=DISABLED

# WebSocket & API
HOST=127.0.0.1
PORT=3000

# Swarm Parameters
POPULATION_SIZE=20
MIN_PAPER_TRADES_VALIDATION=200
CONSENSUS_THRESHOLD=0.60
MIN_QUEEN_CONFIDENCE=0.70
GRAVEYARD_MAX_RECORDS=500
MUTATION_RATE=0.08
PAPER_EXPIRY_SECONDS=60

# Mistral AI (REQUIRED for the vision chart scanner + Queen explanations)
# Get a key at https://console.mistral.ai
# MULTI-KEY POOL: comma separated list. When one key is rate-limited (429) the
# server automatically rotates to the next key and cools the rejected one for 60s.
MISTRAL_API_KEYS=your_key_1,your_key_2
# Fallback single key (only used if MISTRAL_API_KEYS is empty)
MISTRAL_API_KEY=
# Vision model used to read the captured Quotex chart screenshots
# (pixtral models are deprecated; free-tier keys should use ministral-8b-latest)
MISTRAL_VISION_MODEL=ministral-8b-latest
# Text model used for Queen decision explanations
# (open-mistral-nemo works on free-tier keys; mistral-small is quota-blocked there)
MISTRAL_TEXT_MODEL=open-mistral-nemo
